# dnscomplex example for a Debian 13 VM behind RouterOS 7.
# RouterOS keeps the LAN default-gateway role and policy-routes selected
# clients to this VM for dnscomplex processing.

DNSCOMPLEX_NONINTERACTIVE=1
DEPLOY_MODE=routeros-policy

# VM NIC on Debian 13.
WAN_IFACE=ens18

# Example LAN values. Replace with your own RouterOS and VM addresses.
ROUTEROS_LAN_IPV4=192.168.50.253
LINUX_LAN_IPV4=192.168.50.200
LAN_CLIENT_IPV4_CIDR=192.168.50.0/24

# SOCKS endpoint for LAN clients.
SINGBOX_SOCKS_LISTEN=192.168.50.200
SINGBOX_SOCKS_PORT=1080

# Management and observability endpoints.
DNSCOMPLEX_WEB_LISTEN=192.168.50.200
DNSCOMPLEX_WEB_PORT=8088
DNSCOMPLEX_METRICS_LISTEN=0.0.0.0
DNSCOMPLEX_METRICS_PORT=9108
PROMETHEUS_MODE=exporter-only

# SmartDNS is the DNS cache authority. AdGuard keeps filtering/querylog only.
ADGUARD_DNS_CACHE_MODE=off

# Active/passive HA. Keep single until a second VM is built.
HA_MODE=single
HA_PRIMARY_IP=192.168.50.200
HA_SECONDARY_IP=
HA_HEALTH_URL=/healthz
HA_FAILOVER_POLICY=primary-secondary-routeros

# Default IPsec servers from the current installer defaults.
AI_IPSEC_SERVER=sx301001-ikev.ptoserver.com
CN_IPSEC_SERVER=sx351401-ikev.ptoserver.com
IPSEC_REMOTE_ID=pointtoserver.com

# auto: return AAAA from default DNS only when the VM can really open IPv6 TCP.
DEFAULT_IPV6_MODE=auto

# Replace these before a real install, or change later with:
#   dnscomplex set-ipsec ai USER PASSWORD
#   dnscomplex set-ipsec cn USER PASSWORD
AI_IPSEC_USERNAME=CHANGE_ME_AI_USER
AI_IPSEC_PASSWORD=CHANGE_ME_AI_PASSWORD
CN_IPSEC_USERNAME=CHANGE_ME_CN_USER
CN_IPSEC_PASSWORD=CHANGE_ME_CN_PASSWORD
